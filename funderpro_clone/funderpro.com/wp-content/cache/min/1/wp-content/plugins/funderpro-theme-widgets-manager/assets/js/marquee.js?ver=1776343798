jQuery(document).ready(function($){$('.block-marquee-wrapper').each(function(){var marqueeWrapper=$(this);var marqueeTrack=marqueeWrapper.find('.block-marquee__track');var marqueeItems=marqueeTrack.children();var isRTL=$('html').attr('dir')==='rtl';marqueeItems.clone().appendTo(marqueeTrack);var totalWidth=0;marqueeItems.each(function(){totalWidth+=$(this).outerWidth(!0)});marqueeTrack.css('width',totalWidth*2);var currentPos=0;var step=1;function animateMarquee(){if(isRTL){currentPos+=step;marqueeTrack.css('transform','translateX('+currentPos+'px)');if(currentPos>=totalWidth){currentPos=0;marqueeTrack.css('transform','translateX('+currentPos+'px)')}}else{currentPos-=step;marqueeTrack.css('transform','translateX('+currentPos+'px)');if(Math.abs(currentPos)>=totalWidth){currentPos=0;marqueeTrack.css('transform','translateX('+currentPos+'px)')}}
requestAnimationFrame(animateMarquee)}
animateMarquee()})})